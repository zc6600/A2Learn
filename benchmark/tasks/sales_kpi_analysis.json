      {
        "region": "Europe",
        "revenue": 980000,
        "ad_spend": 210000,
        "leads": 6200,
        "conversions": 682,
        "churn_rate": 0.058
      },
      {
        "region": "Asia Pacific",
        "revenue": 1540000,
        "ad_spend": 220000,
        "leads": 12400,
        "conversions": 1860,
        "churn_rate": 0.032
      },
      {
        "region": "Latin America",
        "revenue": 430000,
        "ad_spend": 95000,
        "leads": 3100,
        "conversions": 279,
        "churn_rate": 0.071
