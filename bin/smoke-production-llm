#!/usr/bin/env python3
"""Compare the production A2Learn generation pipeline across fixed models.

This intentionally talks to the deployed API, not a mock. Results are written
as raw JSON so a failed or visually weak generation can be inspected later.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
import time
import urllib.error
import urllib.request
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

# Keep this list aligned with A2LEARN_ALLOWED_GENERATION_MODELS in
# config/deploy.yml. Edit this source list when evaluating a different cohort.
CANDIDATE_MODELS = (
    "deepseek/deepseek-v4-flash",
    "google/gemini-2.5-flash",
    "qwen/qwen3-235b-a22b-2507",
)

DEFAULT_PROMPT = """请生成一节面向初学者的网页课，主题是「哈希表为什么会冲突，以及如何处理冲突」。
必须解释：哈希函数、冲突、链地址法、开放寻址法；给一个不超过 5 个步骤的小例子；避免假设读者有编程基础。"""
DEFAULT_API_URL = "https://api.a2learn.zc6600.wiki"


def _request(url: str, method: str, payload: dict[str, Any] | None, timeout: float) -> dict[str, Any]:
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8") if payload is not None else None
    request = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={"Accept": "application/json", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            decoded = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"HTTP {exc.code}: {body[:600]}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(f"network error: {exc.reason}") from exc
    try:
        value = json.loads(decoded)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON response: {decoded[:300]}") from exc
    if not isinstance(value, dict):
        raise TypeError("API returned a JSON value other than an object")
    return value


def _counts(messages: list[Any]) -> tuple[int, int, int]:
    surfaces: set[str] = set()
    components = 0
    for message in messages:
        if not isinstance(message, dict):
            continue
        for key in ("createSurface", "updateComponents"):
            value = message.get(key)
            if isinstance(value, dict) and isinstance(value.get("surfaceId"), str):
                surfaces.add(value["surfaceId"])
        update = message.get("updateComponents")
        if isinstance(update, dict) and isinstance(update.get("components"), list):
            components += len(update["components"])
    serialized = json.dumps(messages, ensure_ascii=False, separators=(",", ":"))
    return len(surfaces), components, len(serialized)


def _safe_filename(model: str) -> str:
    return re.sub(r"[^a-zA-Z0-9_.-]+", "-", model).strip("-")


def _print_table(rows: list[dict[str, Any]]) -> None:
    headers = ("model", "run", "result", "seconds", "surfaces", "components", "chars")
    rendered = [
        {
            "model": str(row["model"]),
            "run": str(row["run"]),
            "result": str(row["status"]),
            "seconds": f"{row['durationSeconds']:.1f}",
            "surfaces": str(row.get("surfaceCount", "-")),
            "components": str(row.get("componentCount", "-")),
            "chars": str(row.get("outputCharacters", "-")),
        }
        for row in rows
    ]
    widths = {key: max(len(key), *(len(row[key]) for row in rendered)) for key in headers}
    print("  ".join(key.ljust(widths[key]) for key in headers))
    print("  ".join("-" * widths[key] for key in headers))
    for row in rendered:
        print("  ".join(row[key].ljust(widths[key]) for key in headers))


def _print_summary(rows: list[dict[str, Any]], runs: int) -> None:
    print("\nSummary")
    for model in CANDIDATE_MODELS:
        model_rows = [row for row in rows if row["model"] == model]
        completed = [row for row in model_rows if row["status"] == "ready"]
        average = sum(row["durationSeconds"] for row in completed) / len(completed) if completed else 0
        print(f"- {model}: {len(completed)}/{runs} succeeded; avg {average:.1f}s among successful runs")


def _evaluate_model(base_url: str, model: str, prompt: str, poll_interval: float, timeout: float) -> dict[str, Any]:
    session_id = f"sess_smoke_{uuid.uuid4().hex[:16]}"
    started = time.monotonic()
    start = _request(
        f"{base_url}/api/session/start",
        "POST",
        {"sessionId": session_id, "resource_text": prompt, "language": "zh", "model": model},
        timeout,
    )
    session_id = str(start.get("session_id", session_id))
    deadline = time.monotonic() + timeout
    status = start
    while status.get("status") == "pending":
        if time.monotonic() >= deadline:
            raise RuntimeError(f"timed out after {timeout:.0f}s while waiting for session {session_id}")
        time.sleep(poll_interval)
        status = _request(f"{base_url}/api/session/{session_id}/status", "GET", None, timeout)

    duration = time.monotonic() - started
    messages = status.get("messages") if isinstance(status.get("messages"), list) else []
    result: dict[str, Any] = {
        "model": model,
        "reportedModel": status.get("model") or start.get("model"),
        "sessionId": session_id,
        "status": status.get("status", "unknown"),
        "durationSeconds": round(duration, 3),
        "createdAt": status.get("createdAt"),
        "updatedAt": status.get("updatedAt"),
        "error": status.get("error"),
        "response": status,
    }
    if result["status"] == "ready":
        surface_count, component_count, output_characters = _counts(messages)
        result.update(
            surfaceCount=surface_count,
            componentCount=component_count,
            outputCharacters=output_characters,
        )
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Run the same A2Learn generation through each benchmark model.")
    parser.add_argument("--url", default=DEFAULT_API_URL, help=f"API base URL (default: {DEFAULT_API_URL})")
    parser.add_argument("--prompt", default=DEFAULT_PROMPT, help="Shared source text / generation instruction")
    parser.add_argument("--timeout", type=float, default=600, help="Maximum seconds per model (default: 600)")
    parser.add_argument("--interval", type=float, default=2.5, help="Status polling interval in seconds (default: 2.5)")
    parser.add_argument("--runs", type=int, default=1, help="Attempts per model, for measuring success rate (default: 1)")
    parser.add_argument("--output-dir", type=Path, default=None, help="Directory for raw JSON results")
    parser.add_argument("--verbose", action="store_true", help="Print every result artifact path")
    args = parser.parse_args()
    if args.timeout <= 0 or args.interval <= 0 or args.runs <= 0:
        parser.error("--timeout, --interval, and --runs must be positive")

    base_url = args.url.rstrip("/")
    timestamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    output_dir = args.output_dir or Path("reports/llm-smoke") / timestamp
    output_dir.mkdir(parents=True, exist_ok=True)

    print(f"A2Learn production LLM smoke test: {base_url}")
    print(f"Models: {', '.join(CANDIDATE_MODELS)}")
    print(f"Artifacts: {output_dir}")
    rows: list[dict[str, Any]] = []
    for model in CANDIDATE_MODELS:
        for run in range(1, args.runs + 1):
            print(f"\n→ {model} (run {run}/{args.runs})", flush=True)
            try:
                result = _evaluate_model(base_url, model, args.prompt, args.interval, args.timeout)
            except Exception as exc:  # noqa: BLE001 - preserve an artifact for every failed attempt.
                result = {
                    "model": model,
                    "status": "request-error",
                    "durationSeconds": 0.0,
                    "error": str(exc),
                }
            result["run"] = run
            artifact = output_dir / f"{_safe_filename(model)}-run{run:02d}.json"
            artifact.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
            rows.append(result)
            if args.verbose:
                print(f"  saved {artifact}")

    print()
    _print_table(rows)
    _print_summary(rows, args.runs)
    failures = [row for row in rows if row["status"] != "ready"]
    if failures:
        print("\nFailures:")
        for row in failures:
            print(f"- {row['model']}: {row.get('error') or row['status']}")
        return 1
    print("\nAll models completed successfully.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
