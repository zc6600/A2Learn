#!/usr/bin/env bash
set -e

# ==============================================================================
# A2Learn Local Test Runner
# ==============================================================================
# Usage:
#   bin/test              # Run full test suite (lint + tests + build)
#   bin/test --quick, -q  # Run all tests without full build
#   bin/test --py, -p     # Run Python unit tests only
#   bin/test --js, -f     # Run Frontend/JS unit tests only
#   bin/test --lint, -l   # Run style boundary checks only
#   bin/test --build, -b  # Run frontend build check only
#   bin/test <pattern>    # Run matching Python test file/pattern
# ==============================================================================

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${BLUE}${BOLD}[TEST]${NC} $1"
}

log_success() {
    echo -e "${GREEN}${BOLD}✓${NC} $1"
}

log_error() {
    echo -e "${RED}${BOLD}✗${NC} $1"
}

# Determine python runner (prefer uv run python, fallback to python)
if command -v uv >/dev/null 2>&1; then
    PYTHON_CMD="uv run python"
else
    PYTHON_CMD="python"
fi

run_lint() {
    log_info "Running style boundary checks..."
    node scripts/check-style-boundaries.mjs
    log_success "Style boundary checks passed."
}

run_frontend_tests() {
    log_info "Running frontend workspace tree tests..."
    node --test tests/test_workspace_tree.mjs
    log_success "Frontend tests passed."
}

run_python_tests() {
    local pattern="${1:-test_*.py}"
    log_info "Running Python unit tests (pattern: $pattern)..."
    $PYTHON_CMD -m unittest discover -s tests -p "$pattern"
    log_success "Python tests passed."
}

run_build() {
    log_info "Building frontend packages (a2learn-viewer & @a2learn/embed)..."
    npm run build
    log_success "Build completed successfully."
}

show_help() {
    echo -e "${BOLD}A2Learn Local Test Runner${NC}"
    echo ""
    echo "Usage:"
    echo "  bin/test [options] [pattern]"
    echo ""
    echo "Options:"
    echo "  -a, --all        Run all tests, style checks, and build (default)"
    echo "  -q, --quick      Run all tests and style checks, skip build"
    echo "  -p, --py         Run Python unit tests only"
    echo "  -f, --js         Run Frontend / JS unit tests only"
    echo "  -l, --lint       Run style boundary linting only"
    echo "  -b, --build      Run frontend build only"
    echo "  -h, --help       Show this help message"
    echo ""
    echo "Examples:"
    echo "  bin/test"
    echo "  bin/test -q"
    echo "  bin/test -p test_api_main.py"
    echo "  bin/test -p *course*"
    echo ""
}

MODE="all"
PATTERN="test_*.py"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -a|--all)
            MODE="all"
            shift
            ;;
        -q|--quick)
            MODE="quick"
            shift
            ;;
        -p|--py|--python)
            MODE="python"
            if [[ -n "$2" && "$2" != -* ]]; then
                PATTERN="$2"
                shift
            fi
            shift
            ;;
        -f|--js|--frontend)
            MODE="frontend"
            shift
            ;;
        -l|--lint)
            MODE="lint"
            shift
            ;;
        -b|--build)
            MODE="build"
            shift
            ;;
        *)
            # Assume it's a test file pattern for python
            MODE="python"
            PATTERN="$1"
            shift
            ;;
    esac
done

echo "=========================================="
echo "🧪 A2Learn Test Suite (Mode: $MODE)"
echo "=========================================="

case "$MODE" in
    lint)
        run_lint
        ;;
    frontend)
        run_frontend_tests
        ;;
    python)
        run_python_tests "$PATTERN"
        ;;
    build)
        run_build
        ;;
    quick)
        run_lint
        run_frontend_tests
        run_python_tests
        ;;
    all)
        run_lint
        run_frontend_tests
        run_python_tests
        run_build
        ;;
esac

echo ""
echo -e "${GREEN}${BOLD}🎉 All checks and tests passed successfully!${NC}"
