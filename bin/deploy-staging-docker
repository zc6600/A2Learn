#!/usr/bin/env bash
# ==============================================================================
# Deploy the A2Learn backend to the Aliyun staging ECS via Kamal.
#
# A2Learn is a Python project (no Gemfile/bundler), so this calls the plain
# `kamal` CLI — install it once with: gem install kamal
# ==============================================================================
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

STAGING_SERVER="39.105.9.33"
SSH_USER="root"
KAMAL_PROXY_IMG="basecamp/kamal-proxy:v0.9.2"
MIRROR_PROXY_IMG="m.daocloud.io/docker.io/basecamp/kamal-proxy:v0.9.2"

echo "[deploy-staging-docker] 检查阿里云 ECS (${STAGING_SERVER}) 上的 kamal-proxy 镜像..."
ssh -o ConnectTimeout=5 "${SSH_USER}@${STAGING_SERVER}" "
  if ! docker image inspect ${KAMAL_PROXY_IMG} >/dev/null 2>&1; then
    echo '[deploy-staging-docker] 通过 DaoCloud 镜像拉取 kamal-proxy...'
    docker pull ${MIRROR_PROXY_IMG} && docker tag ${MIRROR_PROXY_IMG} ${KAMAL_PROXY_IMG}
  fi
"

echo "[deploy-staging-docker] 开始部署到 Staging..."
START_TIME=$(date +%s)
kamal deploy -d staging "$@"
END_TIME=$(date +%s)
echo "[deploy-staging-docker] 部署完成，耗时 $((END_TIME - START_TIME)) 秒。"
