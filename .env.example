# LLM Configuration (OpenRouter / OpenAI compatible)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_MAX_TOKENS=200000
# OPENROUTER_EDITOR_MODEL=deepseek/deepseek-v4-flash

# Text-to-speech (OpenAI-compatible OpenRouter endpoint)
# Change only these values to swap the TTS model or voice.
A2LEARN_TTS_MODEL=hexgrad/kokoro-82m
# Optional language-specific voices; Kokoro defaults are zf_xiaobei / af_heart.
# A2LEARN_TTS_VOICE_ZH=zf_xiaobei
# A2LEARN_TTS_VOICE_EN=af_heart
# A2LEARN_TTS_ENDPOINT=https://openrouter.ai/api/v1/audio/speech
# A2LEARN_TTS_RESPONSE_FORMAT=mp3
# A2LEARN_TTS_HTTP_REFERER=https://your-site.example
# A2LEARN_TTS_TITLE=A2Learn

# Static narration assets (recommended for production)
# Upload the MP3 files to object storage/CDN and set this before viewer:build.
# Leave empty for local development with files in apps/viewer/public/examples/audio.
# VITE_A2LEARN_AUDIO_BASE_URL=https://cdn.example.com/a2learn-audio

# API & Server Configuration
# A2LEARN_MODE=agent
# A2LEARN_ALLOWED_ORIGINS=*

# Storage Configuration (Default uses local sqlite)
# A2LEARN_PAGE_DOCUMENT_DB_PATH=./data/a2learn.sqlite3
# A2LEARN_KNOWLEDGE_DB_PATH=./data/a2learn-knowledge.sqlite3
# A2LEARN_KNOWLEDGE_STORAGE_ROOT=./data/knowledge-files
