        {
          "id": "dialogue",
          "component": "ScenarioDialogue",
          "topic": {
            "literalString": "Dialogue: Absolute vs. Relative Spacetime"
          },
          "characters": {
            "newton": {
              "name": {
                "literalString": "Newton"
              },
              "avatar": {
                "literalString": "🍎"
              },
              "alignment": "left"
            },
            "einstein": {
              "name": {
                "literalString": "Einstein"
              },
              "avatar": {
                "literalString": "🌌"
              },
              "alignment": "right"
            }
          },
          "messages": [
            {
              "characterId": "newton",
              "content": {
                "literalString": "Time and space are like a grand stage; no matter what happens on it, the stage itself remains unchanged. Time flows uniformly forever."
              },
              "delayMs": 1000
            },
            {
              "characterId": "einstein",
              "content": {
                "literalString": "Forgive me, senior, but I must correct you. Time and space not only change, but they are also \"warped\" by mass."
              },
              "delayMs": 2000
            },
            {
              "characterId": "newton",
              "content": {
                "literalString": "Absurd! How could time possibly slow down?"
              },
              "delayMs": 1500
            },
            {
              "characterId": "einstein",
              "content": {
                "literalString": "If you travel fast enough, approaching the speed of light, or if you stand near a black hole with immense gravity, your time will pass much slower than for someone on Earth. This is **Relativity**."
              },
              "delayMs": 3000
            }
          ]
        }
      ]
    }
