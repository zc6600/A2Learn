# Read secrets from your local .env at deploy time — never commit raw values here.
# Add KAMAL_REGISTRY_PASSWORD=<your ACR access token> to your local .env (already gitignored).

KAMAL_REGISTRY_PASSWORD=$(grep -E '^KAMAL_REGISTRY_PASSWORD=' .env | cut -d '=' -f2- | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//")
