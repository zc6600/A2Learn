{
  "name": "a2learn-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run viewer:dev",
    "gallery": "npm run viewer:gallery",
    "viewer:dev": "npm run dev --workspace a2learn-viewer",
    "viewer:editor": "npm run editor --workspace a2learn-viewer --",
    "viewer:gallery": "npm run gallery --workspace a2learn-viewer",
    "viewer:build": "npm run build --workspace a2learn-viewer",
    "embed:build": "npm run build --workspace @a2learn/embed",
    "package": "./scripts/package_submission.py",
    "build": "npm run viewer:build && npm run embed:build",
    "lint:styles": "node scripts/check-style-boundaries.mjs",
    "test:frontend": "node --test tests/test_workspace_tree.mjs",
    "test": "npm run test:frontend && uv run python -m unittest discover -s tests"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
